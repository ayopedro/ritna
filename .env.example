# Also used as the origin for the browser redirect after verification.
# When unset, the redirect uses proxy-forwarded host/protocol headers.
PAYSTACK_CALLBACK_URL=

# Configure your Paystack webhook URL as your public origin + /api/payments/webhook.

RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_SUPPORT_EMAIL=
