DATABASE_URL=postgres://postgres:postgres@localhost:5432/ritna
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
RUN_SEED=false

PAYSTACK_SECRET_KEY=
