DATABASE_URL=postgres://postgres:postgres@localhost:5432/ritna
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
RUN_SEED=false

PAYSTACK_SECRET_KEY=
# Set to your public origin + /api/payments/callback.
# Also used as the origin for the browser redirect after verification.
# When unset, the redirect uses proxy-forwarded host/protocol headers.
PAYSTACK_CALLBACK_URL=

# Configure your Paystack webhook URL as your public origin + /api/payments/webhook.

RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_SUPPORT_EMAIL=

# Provider for new orders: bachs (default) or paystack.
PAYMENT_PROVIDER=bachs
# sk_sandbox_... selects sandbox; sk_live_... selects production.
BACHS_API_KEY=
BACHS_CALLBACK_URL=
BACHS_WEBHOOK_SECRET=
# Bachs callback: public origin + /api/payments/callback
# Bachs webhook: public origin + /api/payments/webhook/bachs

OTEL_SERVICE_NAME=ritna
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES="deployment.environment.name=production"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=